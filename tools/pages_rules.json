        "office",
        "annual",
        "rank",
        "group_rank",
        "scores"
      ],
      "forbidden_keys": [
        "kpis",
        "groupRank"
      ]
    }
  },
  "csv": {
    "budget.csv": {
      "required_columns": [
        "列帳機構",
        "交易機構",
        "年度",
        "月份",
        "總帳科目",
        "明細帳",
