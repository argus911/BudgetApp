      "const": "DATA",
      "top_keys": [
        "kpi",
        "groups",
        "history",
        "actual"
      ],
      "kpi_ids": [
        "O1",
        "O2",
        "L1",
        "L2",
        "L3",
        "L4",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5",
        "M6",
        "M7",
        "E"
      ],
      "records_min": 17,
      "records_max": 17,
      "record_keys": [
        "office",
        "annual",
        "rank",
        "group_rank",
        "scores"
      ],
      "forbidden_keys": [
        "kpis",
        "groupRank"
      ],
      "same_period_as": "KPI/actual_history.json"
    },
    "KPI/actual_history.json": {
      "kpi_ids": [
        "O1",
        "O2",
        "L1",
        "L2",
        "L3",
        "L4",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5",
        "M6",
        "M7",
        "E"
      ],
