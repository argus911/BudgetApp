{
  "_說明": "GitHub Pages 上線前檢查規則（tools/check_pages.py 讀取）。筆數範圍、必要欄位可在這裡調整。",
  "global_must_not_contain": [],
  "pages": {
    "index.html": {
      "min_bytes": 100000
    },
    "KPI/index.html": {
      "min_bytes": 150000
    },
    "ICTCost/index.html": {
      "min_bytes": 30000
    },
    "BonusPoints/index.html": {
      "min_bytes": 50000
    }
  },
  "kpi": {
